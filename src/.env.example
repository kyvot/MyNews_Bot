# Telegram
BOT_TOKEN=
XTGTOK=
DEFAULT_ADMIN_ID=
# Full Bot API ID (-100...) or the positive compact ID from t.me/c/...
GROUP_ID=
# Full Bot API ID (-100...) or its positive compact form
CHANNEL_ID=
# Required by the bot: every Telegram Bot API call uses this SOCKS5 proxy.
# aiogram uses remote DNS for the socks5:// scheme.
PROXY_URL=socks5://127.0.0.1:2080

# Public webhook URL (required by Config even in long-polling mode)
BASE_URL=https://example.com

# PostgreSQL / asyncpg
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_db

# Parser
PARSER_AUTOSTART=false
PARSER_INTERVAL_SECONDS=900
PARSER_MAX_POSTS_PER_CYCLE=20
PARSER_PUBLISH_DELAY_SECONDS=3
PARSER_TELEGRAM_MAX_RETRIES=3
PARSER_TARGET_VALIDATION_TIMEOUT=5
PARSER_VOTING_HOURS=72
PARSER_MAX_IMAGES=4
NEWS_HIT_SCORE=3
NEWS_PUBLICATION_LEASE_SECONDS=900
PARSER_TRANSLATION_ENABLED=true
PARSER_TRANSLATION_REQUIRED=true
PARSER_TRANSLATION_MAX_CHARS=3500

# DeepL translates parser titles/descriptions and normalizes summary language
# through HTTPX2. A valid key is required when fail-closed translation is on.
DEEPL_API_KEY=
# Leave unset: :fx keys select API Free, all other keys select API Pro.
# DEEPL_TRANSLATE_URL=https://api-free.deepl.com/v2/translate
# Optional. This proxy is independent from the Telegram SOCKS5 proxy.
# DEEPL_PROXY_URL=socks5://127.0.0.1:2080
DEEPL_REQUEST_TIMEOUT=20
DEEPL_MAX_RETRIES=2
DEEPL_MAX_CONCURRENCY=4

# Single content-language setting for parser cards and summaries. A language
# name, ISO code, or locale is accepted: Russian/ru/ru-RU, English/en/en-US.
AI_LANGUAGE=Russian

# OpenRouter is used only to generate article summaries.
# The model can be replaced with any OpenRouter model slug.
AI_PROVIDER=openrouter
OPENROUTER_CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_APP_TITLE=MyNews
# Optional attribution URL.
# OPENROUTER_HTTP_REFERER=https://example.com
# Optional. Set this when OpenRouter itself must use a proxy.
# OPENROUTER_PROXY_URL=socks5://127.0.0.1:2080
AI_EXTRACTIVE_FALLBACK_ENABLED=false
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=350
AI_MAX_RETRIES=3
AI_MAX_CONCURRENCY=2
AI_SUMMARY_MAX_CHARS=1600
ARTICLE_EXTRACT_WORKERS=1
ARTICLE_EXTRACT_TIMEOUT=30
ARTICLE_MAX_CONCURRENCY=2

# APScheduler UI timezone
SCHEDULER_TIMEZONE=Europe/Moscow
SCHEDULER_SHUTDOWN_GRACE_SECONDS=30
SCHEDULER_SHUTDOWN_CANCEL_SECONDS=10
